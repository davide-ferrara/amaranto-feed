rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validChatMessage() {
      let message = request.resource.data;
      return message.keys().hasAll(['userId', 'userName', 'text', 'createdAt'])
        && message.keys().hasOnly(['userId', 'userName', 'text', 'createdAt'])
        && message.userId == request.auth.uid
        && message.userName is string
        && message.userName.size() > 0
        && message.userName.size() <= 60
        && message.userName == request.auth.token.get('name', 'Tifoso')
        && message.text is string
        && message.text.size() > 0
        && message.text.size() <= 1000
        && message.createdAt == request.time;
    }

    match /chat_messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validChatMessage();
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.userId == request.auth.uid;
    }
  }
}
